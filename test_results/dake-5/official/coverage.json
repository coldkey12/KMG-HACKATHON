  },
  {
   "unit_id": "u-088-07e434",
   "kind": "paragraph",
   "page_pdf": 88,
   "excerpt": "Equation (7.5) can now be integrated between the limits t = 0",
   "node_ids": [
    "dake-5.n-088-07e434"
