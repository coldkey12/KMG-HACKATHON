    "dake-5.n-087-3b2d79"
   ],
   "reason": null
  },
  {
   "unit_id": "u-087-c0a8aa",
   "kind": "paragraph",
   "page_pdf": 87,
   "excerpt": "Equation (5.20) can be expressed with respect to this new variable as",
