    "dake-5.n-087-3b2d79"
   ],
   "reason": null
  },
  {
   "unit_id": "u-087-eae1cd",
   "kind": "formula",
   "page_pdf": 87,
   "excerpt": "frac{ partial s}{ partial t} = - frac{ phi mu c r^2}{4kt^2}",
