   "unit_id": "u-087-4b132d",
   "kind": "formula",
   "page_pdf": 87,
   "excerpt": "frac{ partial s}{ partial r} = frac{ phi mu c r}{2kt} tag{7.2}",
   "node_ids": [
    "dake-5.n-087-3b2d79"
   ],
   "reason": null
  },
  {
   "unit_id": "u-087-cffa50",
   "kind": "paragraph",
   "page_pdf": 87,
   "excerpt": "and",
