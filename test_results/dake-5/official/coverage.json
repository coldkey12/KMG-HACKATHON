  },
  {
   "unit_id": "u-087-cf47cc",
   "kind": "formula",
   "page_pdf": 87,
   "excerpt": "s = frac{r^2}{4( text{Diffusivity constant})t} = frac{ phi mu c r^2}{4kt}",
